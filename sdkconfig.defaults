# Target: ESP32-S3 N16R8 (16 MB quad flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# DIO, as Switch2Connect uses: works on every N16R8 flash chip. (QIO is only a
# small speed-up and depends on the flash chip having its QE bit set.)
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# PSRAM is not used until step 3/4; leaving it off removes one boot-time failure point.
# (When enabled: CONFIG_SPIRAM=y + CONFIG_SPIRAM_MODE_OCT=y for the N16R8.)
CONFIG_SPIRAM=n

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Logs go to UART0 (the board's "COM"/"UART" USB-C port) and are mirrored to the
# dongle's own USB CDC serial port by the firmware. The USB-Serial-JTAG console
# is disabled because TinyUSB owns the native USB PHY.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Bluetooth: NimBLE configured like Switch2Connect's known-working bridge.
# The dongle only acts as a central, but the GATT server, peripheral role and
# security support stay enabled as they are there: a central with no ATT server
# leaves the controller's own ATT requests unanswered. Switch 2 controllers use
# Nintendo's application-level pairing, so SMP is never started by us.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_GATT_SERVER=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_EXT_SCAN=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=8
CONFIG_BT_NIMBLE_MAX_BONDS=8
CONFIG_BT_NIMBLE_MAX_CCCDS=24
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=256
# Bigger mbuf pool / more concurrent GATT procedures: two Joy-Cons at 7.5 ms plus
# rumble writes exhaust the defaults (learned the hard way by Switch2Connect).
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=48
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=8
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
# Wi-Fi is never started; turn off the Wi-Fi/BT coexistence arbiter so BLE gets
# the radio to itself.
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=n

# TinyUSB: one HID gamepad interface + one CDC serial port for logs.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_HID_COUNT=1
# Web configurator: USB network (CDC NCM) at 192.168.7.1.
CONFIG_TINYUSB_NET_MODE_NCM=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

# Diagnostics (0.1.1): roomier stacks for tasks that log, and crash reports
# saved to flash (ELF format, so the firmware can summarise them on next boot).
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=7168
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
